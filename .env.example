# PLANOVA Configuration Example

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/planova?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/planova
# Note: If left blank or local mongod is not detected, an embedded in-memory MongoDB instance will automatically be used.
MONGODB_URI=

# JWT Secret Key (change this to a secure random string in production)
JWT_SECRET=planova_super_secret_jwt_key_2026

# JWT Expiration
JWT_EXPIRES_IN=7d
